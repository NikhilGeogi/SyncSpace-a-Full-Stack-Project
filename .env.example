# 複製本檔成 .env，然後改掉 DB_PASSWORD：
#   cp .env.example .env
# .env 已列入 .gitignore，不會進版控。

# MySQL root 密碼（必填，沒設 docker compose 會直接拒絕啟動）
DB_PASSWORD=change-me-please

# 資料庫名稱。改成任何名字都可以 —— compose 會把它同時交給 MySQL 建庫
# 與應用程式連線，database/schema.sql 不再寫死庫名。
DB_NAME=test

# 應用程式對外埠，瀏覽器開 http://localhost:<APP_PORT>/
APP_PORT=8080

# MySQL 對外埠。預設 3307 是為了避開本機既有的 MySQL(3306)，
# 想用 Workbench / phpMyAdmin 連容器就指向 127.0.0.1:3307
DB_HOST_PORT=3307
